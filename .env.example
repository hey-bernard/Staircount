# Supabase Postgres connection strings.
# Project Settings -> Database -> Connection string in the Supabase dashboard.
#
# DATABASE_URL: pooled connection (port 6543, "Transaction" mode / pgbouncer) -
#   used by the app at runtime (serverless-friendly).
# DIRECT_URL: direct connection (port 5432) -
#   used only by `prisma migrate` to run schema migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Anthropic API key used by the AI coach (src/lib/agent.ts).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
